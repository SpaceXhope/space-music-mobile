{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "space-music-mobile",
  "main": "worker.js",
  "compatibility_date": "2026-11-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist-web",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
